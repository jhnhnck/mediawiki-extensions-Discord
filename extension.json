{
    "name": "NovaDiscord",
    "author": [
        "[https://github.com/jhnhnck John Hancock]"
    ],
    "url": "https://github.com/jhnhnck/mediawiki-extensions-NovaDiscord",
    "version": "2.1.0",
    "descriptionmsg": "discord-desc",
    "license-name": "MIT",
    "requires": {
        "MediaWiki": ">= 1.44.0"
    },
    "manifest_version": 1,
    "config": {
        "DiscordWebhookURL": [],
        "DiscordNoBots": true,
        "DiscordNoMinor": false,
        "DiscordNoNull": true,
        "DiscordSuppressPreviews": true,
        "DiscordMaxChars": 500,
        "DiscordMaxCharsUsernames": 25,
        "DiscordDisabledHooks": [],
        "DiscordDisabledNS": [],
        "DiscordDisabledUsers": [
            "Redirect fixer"
        ],
        "DiscordPrependTimestamp": false,
        "DiscordUseEmojis": false,
        "DiscordPrivateExceptionAlerts": false,
        "DiscordEmojis": {
            "PageSaveComplete": ":pencil2:",
            "PageDeleteComplete": ":wastebasket:",
            "PageUndeleteComplete": ":wastebasket:",
            "ArticleRevisionVisibilitySet": ":spy:",
            "ArticleProtectComplete": ":lock:",
            "PageMoveComplete": ":truck:",
            "LocalUserCreated": ":wave:",
            "BlockIpComplete": ":no_entry_sign:",
            "UnblockUserComplete": ":no_entry_sign:",
            "UserGroupsChanged": ":people_holding_hands:",
            "UploadComplete": ":inbox_tray:",
            "FileDeleteComplete": ":wastebasket:",
            "FileUndeleteComplete": ":wastebasket:",
            "AfterImportPage": ":books:",
            "ArticleMergeComplete": ":card_box:",
            "RenameUserComplete": ":people_holding_hands:",
            "LogException": ":warning:"
        }
    },
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\": "includes/"
    },
    "TestAutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Doubles\\": "tests/doubles/",
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Integration\\": "tests/phpunit/integration/"
    },
    "MessagesDirs": {
        "mw-discord": "i18n"
    },
    "HookHandlers": {
        "PageAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\PageAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "WikiPageFactory"
            ]
        },
        "UserAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\UserAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory"
            ]
        },
        "ArticleAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ArticleAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory"
            ]
        },
        "FileAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\FileAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory"
            ]
        },
        "ExtensionAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ExtensionAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory"
            ]
        },
        "ErrorAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ErrorAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils"
            ]
        }
    },
    "Hooks": {
        "PageDeleteComplete": "PageAlert",
        "PageMoveComplete": "PageAlert",
        "PageSaveComplete": "PageAlert",
        "PageUndeleteComplete": "PageAlert",
        "ArticleRevisionVisibilitySet": "ArticleAlert",
        "ArticleProtectComplete": "ArticleAlert",
        "AfterImportPage": "ArticleAlert",
        "ArticleMergeComplete": "ArticleAlert",
        "LocalUserCreated": "UserAlert",
        "BlockIpComplete": "UserAlert",
        "UnblockUserComplete": "UserAlert",
        "UserGroupsChanged": "UserAlert",
        "UploadComplete": "FileAlert",
        "FileDeleteComplete": "FileAlert",
        "FileUndeleteComplete": "FileAlert",
        "RenameUserComplete": "ExtensionAlert",
        "LogException": "ErrorAlert"
    }
}
