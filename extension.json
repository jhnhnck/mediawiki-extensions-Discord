{
    "name": "NovaDiscord",
    "author": [
        "[https://github.com/jhnhnck John Hancock]"
    ],
    "url": "https://github.com/jhnhnck/mediawiki-extensions-NovaDiscord",
    "version": "3.0.0",
    "descriptionmsg": "discord-desc",
    "license-name": "MIT",
    "requires": {
        "MediaWiki": ">= 1.44.0"
    },
    "manifest_version": 2,
    "config": {
        "DiscordWebhooks": {
            "value": [],
            "description": "Array of webhook configurations. Each entry must have a 'url' key (string) and an optional 'hooks' key (array of hook names, or null). If 'hooks' is absent, the webhook uses DiscordDefaultHooks. Example: [{'url': 'https://...', 'hooks': ['PageSaveComplete']}]"
        },
        "DiscordDefaultHooks": {
            "value": null,
            "description": "Default set of hook names enabled for webhooks that do not specify their own 'hooks' key. null means all hooks are enabled."
        },
        "DiscordNoBots": {
            "value": true,
            "description": "If true, actions performed by bot accounts do not trigger webhook notifications."
        },
        "DiscordNoMinor": {
            "value": false,
            "description": "If true, minor edits do not trigger a PageSaveComplete notification."
        },
        "DiscordNoNull": {
            "value": true,
            "description": "If true, null edits (no content change) do not trigger a PageSaveComplete notification."
        },
        "DiscordMaxChars": {
            "value": 500,
            "description": "Maximum number of characters shown for user-provided text such as edit summaries and block reasons. Longer text is truncated."
        },
        "DiscordDisabledNS": {
            "value": [],
            "description": "Array of namespace IDs whose page events should not trigger notifications."
        },
        "DiscordDisabledUsers": {
            "value": [
                "Redirect fixer"
            ],
            "description": "Array of usernames whose actions should not trigger notifications."
        },
        "DiscordPrivateExceptionAlerts": {
            "value": false,
            "description": "If true, unhandled PHP exceptions are posted to the webhook. Rate-limited per exception fingerprint. Opt-in only."
        }
    },
    "ServiceWiringFiles": [
        "ServiceWiring.php"
    ],
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\": "includes/"
    },
    "TestAutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Doubles\\": "tests/doubles/",
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Integration\\": "tests/phpunit/integration/"
    },
    "MessagesDirs": {
        "mw-discord": "i18n"
    },
    "HookHandlers": {
        "PageAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\PageAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "WikiPageFactory",
                "NovaDiscord.Config"
            ]
        },
        "UserAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\UserAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "NovaDiscord.Config"
            ]
        },
        "ArticleAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ArticleAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "NovaDiscord.Config"
            ]
        },
        "FileAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\FileAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "NovaDiscord.Config"
            ]
        },
        "ExtensionAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ExtensionAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "NovaDiscord.Config"
            ]
        },
        "ErrorAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\ErrorAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "NovaDiscord.Config"
            ]
        }
    },
    "Hooks": {
        "PageDeleteComplete": "PageAlert",
        "PageMoveComplete": "PageAlert",
        "PageSaveComplete": "PageAlert",
        "PageUndeleteComplete": "PageAlert",
        "ArticleRevisionVisibilitySet": "ArticleAlert",
        "ArticleProtectComplete": "ArticleAlert",
        "AfterImportPage": "ArticleAlert",
        "ArticleMergeComplete": "ArticleAlert",
        "LocalUserCreated": "UserAlert",
        "BlockIpComplete": "UserAlert",
        "UnblockUserComplete": "UserAlert",
        "UserGroupsChanged": "UserAlert",
        "UploadComplete": "FileAlert",
        "FileDeleteComplete": "FileAlert",
        "FileUndeleteComplete": "FileAlert",
        "RenameUserComplete": "ExtensionAlert",
        "LogException": "ErrorAlert"
    }
}
