{
    "name": "NovaDiscord",
    "author": [
        "[https://github.com/jhnhnck John Hancock]",
        "[https://github.com/jayktaylor Jayden Bailey]"
    ],
    "url": "https://github.com/jhnhnck/mediawiki-extensions-NovaDiscord",
    "version": "2.0.6",
    "descriptionmsg": "discord-desc",
    "license-name": "MIT",
    "requires": {
        "MediaWiki": ">= 1.44.0"
    },
    "manifest_version": 1,
    "config": {
        "DiscordWebhookURL": [],
        "DiscordNoBots": true,
        "DiscordNoMinor": false,
        "DiscordNoNull": true,
        "DiscordSuppressPreviews": true,
        "DiscordMaxChars": 500,
        "DiscordMaxCharsUsernames": 25,
        "DiscordDisabledHooks": [],
        "DiscordDisabledNS": [],
        "DiscordDisabledUsers": [
            "Redirect fixer"
        ],
        "DiscordPrependTimestamp": false,
        "DiscordUseEmojis": false,
        "DiscordEmojis": {
            "PageSaveComplete": ":pencil2:",
            "PageDeleteComplete": ":wastebasket:",
            "ArticleUndelete": ":wastebasket:",
            "ArticleRevisionVisibilitySet": ":spy:",
            "ArticleProtectComplete": ":lock:",
            "PageMoveComplete": ":truck:",
            "LocalUserCreated": ":wave:",
            "BlockIpComplete": ":no_entry_sign:",
            "UnblockUserComplete": ":no_entry_sign:",
            "UserGroupsChanged": ":people_holding_hands:",
            "UploadComplete": ":inbox_tray:",
            "FileDeleteComplete": ":wastebasket:",
            "FileUndeleteComplete": ":wastebasket:",
            "AfterImportPage": ":books:",
            "ArticleMergeComplete": ":card_box:",
            "ApprovedRevsRevisionApproved": ":white_check_mark:",
            "ApprovedRevsRevisionUnapproved": ":white_check_mark:",
            "ApprovedRevsFileRevisionApproved": ":white_check_mark:",
            "ApprovedRevsFileRevisionUnapproved": ":white_check_mark:",
            "RenameUserComplete": ":people_holding_hands:"
        }
    },
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\": "includes/"
    },
    "TestAutoloadNamespaces": {
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Doubles\\": "tests/doubles/",
        "MediaWiki\\Extension\\NovaDiscord\\Tests\\Integration\\": "tests/phpunit/integration/"
    },
    "MessagesDirs": {
        "mw-discord": "i18n"
    },
    "HookHandlers": {
        "PageAlert": {
            "class": "MediaWiki\\Extension\\NovaDiscord\\PageAlert",
            "services": [
                "HttpRequestFactory",
                "RevisionLookup",
                "TitleFactory",
                "UrlUtils",
                "UserFactory",
                "WikiPageFactory"
            ]
        }
    },
    "Hooks": {
        "PageDeleteComplete": "PageAlert",
        "PageMoveComplete": "PageAlert",
        "PageSaveComplete": "PageAlert",
        "PageUndeleteComplete": "PageAlert",
        "ArticleRevisionVisibilitySet": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onArticleRevisionVisibilitySet",
        "ArticleProtectComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onArticleProtectComplete",
        "LocalUserCreated": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onLocalUserCreated",
        "BlockIpComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onBlockIpComplete",
        "UnblockUserComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onUnblockUserComplete",
        "UserGroupsChanged": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onUserGroupsChanged",
        "UploadComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onUploadComplete",
        "FileDeleteComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onFileDeleteComplete",
        "FileUndeleteComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onFileUndeleteComplete",
        "AfterImportPage": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onAfterImportPage",
        "ArticleMergeComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onArticleMergeComplete",
        "ApprovedRevsRevisionApproved": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onApprovedRevsRevisionApproved",
        "ApprovedRevsRevisionUnapproved": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onApprovedRevsRevisionUnapproved",
        "ApprovedRevsFileRevisionApproved": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onApprovedRevsFileRevisionApproved",
        "ApprovedRevsFileRevisionUnapproved": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onApprovedRevsFileRevisionUnapproved",
        "RenameUserComplete": "MediaWiki\\Extension\\NovaDiscord\\DiscordHooks::onRenameUserComplete"
    }
}
